#include<iostream>
using namespace std;

int main(){

    int n, k=1;
    cin>>n;
    for(int i=0; i<n; i++){
       int a,b,c;
       cin>>a>>b>>c;
       if(a>b)swap(a,b);
       if(a>c)swap(a,c);
       if(b>c)swap(b,c);

       cout<<"Case "<<k++<<": "<<a<<" "<<b<<" "<<c<<endl;
    }
    return 0;
}
