#include<iostream>
using namespace std;

int main()
{
    int n,m, x=1;
    cin>>n;
    for(int i=0; i<n; i++)
    {
        cin>>m;
        cout<<"Case "<<x++<<":";
        for(int j=1; j<=m; j++)
        {
            if(m%j==0)
            {
                cout<<" "<<j;
            }
        }
        cout<<endl;
    }
    return 0;

}
