#include<iostream>
using namespace std;
int main()
{
    int n;
    cin>>n;
    for(int i=0; i<n; i++)
    {
        int m, s = 0;
        cin>>m;
        if(m<=1)cout<<"YES"<<endl;
        if(m>1)
        {
            for(int j=1; j*j<=m; j++)
            {
                if(j*j == m)
                {
                    s = 1;
                    break;
                }
            }
            if(s == 1)
            {
                cout<<"YES"<<endl;
            }
           else
            {
                cout<<"NO"<<endl;
            }
        }
    }

    return 0;
}
