#include<iostream>
using namespace std;
int main()
{
    int n, x;
    cin>>n;

    while(n--)
    {
        cin>>x;
        for(int i=0; i<x; i++)
        {
            for(int j=0; j<x; j++)
            {
                cout<<"*";
            }
            cout<<endl;
        }
        if(n>0) cout<<endl;
       
    }
    return 0;
}
